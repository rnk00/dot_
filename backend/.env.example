# backend/.env.example
# 이 파일을 복사해서 backend/.env 로 만들고 실제 값을 채워넣으세요.
# .env는 git에 커밋되지 않습니다.

# DB (배포 시 호스팅 업체가 주는 JDBC URL로 교체)
DB_URL=jdbc:mysql://localhost:3306/dot_db?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=changeme

# Kakao OAuth (https://developers.kakao.com)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# GitHub OAuth (GitHub > Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT
JWT_SECRET=
JWT_EXPIRATION=86400000

# Google AI (Gemini)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.1-flash-lite

# 프론트엔드 URL (OAuth 로그인 성공 후 리다이렉트 대상)
FRONTEND_URL=http://localhost:5173
